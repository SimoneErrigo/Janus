# Janus configuration (copy to .env)
#
# This file is intentionally safe to commit:
# - Do not put real team passwords here.
# - Keep per-competition values in your local .env (gitignored).

## --- Auth (frontend login) ---
# Password required to access the dashboard.
TEAM_PASSWORD=changeme
## --- Team network ---
# Our team's address on the competition network (e.g. 10.60.25.1). When a
# service's listen address is left empty (or given as ":port"), the proxy
# binds it to TEAM_IP — so you don't retype your team IP for every service.
TEAM_IP=
# Listener bind policy. Direct/host-network deployments use the configured
# service address; the standard bridge Compose file overrides this to wildcard
# automatically because TEAM_IP normally belongs to the Docker host.
DATA_BIND_MODE=configured

## --- Flag detection (highlight-only) ---
# Regex to recognize flags in traffic (used for highlighting + "Contains Flag" filter).
FLAG_REGEX=[A-Z0-9]{31}=
# Match flags regardless of ASCII case (also honored via an inline "(?i)" in
# FLAG_REGEX). Useful when a service lowercases/hex-encodes flags.
FLAG_REGEX_CASE_INSENSITIVE=false
# Also scan a percent-decoded copy of the traffic, so URL-encoded flags
# (e.g. "...%3D" instead of "...=") are still detected. Default: true.
FLAG_DECODE_URL=true

## --- Cleanup policies (0 = disabled) ---
# Delete packets older than N minutes.
CLEANUP_MAX_AGE_MINUTES=30
# When logical SQLite usage exceeds N MB, incrementally delete oldest packets.
# Physical DB/WAL files can remain allocated and are reused without blocking VACUUM.
CLEANUP_MAX_DB_SIZE_MB=500

## --- Flag ID integration (optional) ---
# Enable periodic flag ID fetching (and flag-id matching/highlighting).
FLAGID_ENABLED=false
# Base URL of the competition flagId service.
# - cyberchallenge: e.g. http://10.10.0.1:8081/flagIds
# - forcad:         e.g. http://10.0.0.1/api/client/attack_data/
# - enowars:        e.g. https://10.enowars.com/scoreboard/attack.json
FLAGID_API_URL=http://10.10.0.1:8081/flagIds
# Local team identifier; some formats send it as ?team=, while formats that
# return every team (ForcAD/ENOWARS) resolve it client-side.
OUR_TEAM_ID=1
# Flag ID JSON format:
# - cyberchallenge: nested per-round object format
# - saarctf: saarCTF attack.json format (team id is resolved to team IP)
# - faustctf: FaustCTF teams.json format
# - forcad: ForcAD format (keys by team IP; OUR_TEAM_ID can be the full IP OR
#           just your team number, which is auto-resolved against the IP keys
#           in the response — e.g. "3" matches "10.0.0.3").
# - enowars: ENOWARS Attack Info format (services -> team IP -> round -> values;
#            OUR_TEAM_ID can be the full IP or the numeric team component).
FLAGID_FORMAT=cyberchallenge
# Poll interval in seconds.
FLAGID_POLL_INTERVAL=30

## --- Competition timing (for round-aware flag IDs) ---
# Duration of a single round in seconds. Use the official game value
# (ENOWARS is commonly 60 seconds; verify the current event configuration).
ROUND_DURATION=120
# RFC3339 start timestamp (optional; used to compute round numbers).
COMPETITION_START=
# How many recent rounds of flag IDs to keep in memory.
KEEP_ROUNDS=5
# Default inclusive round window used by the deterministic checker fingerprint.
# Per-service overrides can be configured from the Config page.
# A signature is trusted only when it is safe and appears in EVERY selected
# round. Move the start forward if the opening round may be contaminated, then
# rebuild the baseline from Config after labelling known exploit flows.
BASELINE_START_ROUND=1
BASELINE_END_ROUND=5
# Compute and persist deterministic flow scores. This can also be changed live
# from Config without stopping packet capture or the fast Go rule engine.
SCORING_ENABLED=true

## --- Redis cache (optional) ---
# Leave empty for the simpler single-process setup. To enable the optional
# compose cache profile use: docker compose --profile cache up
# and set REDIS_ADDR=redis:6379 (127.0.0.1:6379 with competition host networking).
REDIS_ADDR=
# If empty, Redis runs without auth.
REDIS_PASSWORD=

## --- Python filters (mitmproxy-style scriptable filtering) ---
# Load .py scripts (each defining `def match(flow): ...`) that run against
# captured traffic and raise alerts, useful for stateful checks the filter
# DSL can't express (e.g. "same user logged in more than once"). Matches show
# up on the Alerts page. Observe is asynchronous; Inline runs synchronously
# only for the selected services/directions/protocols. Returning
# {"drop": True} drops the CURRENT matching message (bounded + fail-open).
# This switch controls only Python processing and can also be changed live from
# Config. Native Go drop/alert rules remain active when it is false.
# Requires python3. It is bundled in the backend image and must be installed
# separately when running the native binary.
PYFILTER_ENABLED=true
# Optional: path to a specific python interpreter (default: auto-detect python3).
PYFILTER_PYTHON=

## --- Advanced / ops ---
# Persistent state directory. The process user must be able to create and
# modify files here. Native deployments commonly use /var/lib/janus.
DATA_DIR=/data
# Directory scanned at runtime for protobuf definitions.
PROTO_DIR=/protos
# PCAP export directory. Leave empty to use ${DATA_DIR}/pcap.
PCAP_EXPORT_DIR=
# Automatically export a PCAP when a static capture stops.
PCAP_AUTO_SAVE=false
# API listening port used by the bundled nginx/Vite proxy. It must match the
# frontend API_BACKEND_PORT setting.
API_PORT=9090
# API bind address.
# - Docker default: 0.0.0.0 (frontend container needs to reach it)
# - Competition host-network: 127.0.0.1 (keep API localhost-only)
API_BIND=0.0.0.0
# Controls capture/flagid behavior:
# - live: normal mode (SSE, periodic flagIds/backfill, cleanup enabled)
# - static: manual capture and manual "apply flagIds", cleanup disabled
TRAFFIC_MODE=live
# Comma-separated preset used only in static mode. Leave empty to capture no
# services: Start Capture remains disabled until one or more services are chosen.
# The selected scope is snapshotted when capture starts.
STATIC_CAPTURE_SERVICE_IDS=
# Flow reconstruction correlation window (seconds).
FLOW_CORRELATION_WINDOW_SECONDS=120
